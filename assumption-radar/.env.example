# Private repositories and higher GitHub API limits
GITHUB_TOKEN=github_pat_...

# Optional: enables AI assumption comparison after deterministic candidate selection
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Optional alternative semantic judge
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
# SEMANTIC_JUDGE_PROVIDER=anthropic

# Optional IBM Bob CLI semantic judge
BOBSHELL_API_KEY=bob_...
BOB_BIN=bob
# SEMANTIC_JUDGE_PROVIDER=bob

# Vercel cannot bundle the licensed Bob Shell CLI. Point it at a private
# MergeGuard server where Bob Shell is installed and MERGEGUARD_GATEWAY_TOKEN
# is set. Keep both values server-side in Vercel environment variables.
BOB_RUNNER_URL=https://your-private-runner.example/api/bob-judge
BOB_RUNNER_TOKEN=replace-with-a-long-random-secret
MERGEGUARD_GATEWAY_TOKEN=replace-with-the-same-long-random-secret

# No API key required when the Codex CLI is already logged in
CODEX_MODEL=gpt-5.4
CODEX_REASONING_EFFORT=medium
# SEMANTIC_JUDGE_PROVIDER=codex

PORT=4317
