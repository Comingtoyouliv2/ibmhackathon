{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assumption-radar.local/schemas/radar-arena-prediction-v0.1.json",
  "title": "Radar arena ranked pair prediction",
  "type": "object",
  "required": ["schemaVersion", "episodeId", "prA", "prB", "rank", "confidence", "decision", "explanation"],
  "properties": {
    "schemaVersion": { "const": "radar-arena-prediction-v0.1" },
    "episodeId": { "type": "string", "minLength": 1 },
    "prA": { "type": "string", "pattern": "^PR-[0-9]{3}$" },
    "prB": { "type": "string", "pattern": "^PR-[0-9]{3}$" },
    "rank": { "type": "integer", "minimum": 1, "maximum": 20 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "decision": { "enum": ["conflict", "review", "independent", "insufficient", "coordination"] },
    "explanation": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
