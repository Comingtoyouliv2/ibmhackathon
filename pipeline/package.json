{
  "name": "pr-conflict-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/fetch.ts",
    "step0": "tsx src/step0.ts",
    "fetch-diffs": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/fetch-diffs.ts",
    "intent": "tsx src/intent.ts",
    "sectors": "tsx src/sectors.ts",
    "sector-drilldown": "tsx src/sector-drilldown.ts",
    "candidates": "tsx src/candidates.ts",
    "review-packets": "tsx src/review-packets.ts",
    "pr-review": "npm run fetch-diffs && npm run sectors && npm run intent && npm run candidates && npm run review-packets && npm run sector-drilldown",
    "evaluate-pairs": "tsx src/evaluate-pairs.ts",
    "audit": "tsx src/audit.ts",
    "platform": "tsx src/server.ts",
    "regression": "tsx src/regression.ts",
    "export-seed": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/export-seed.ts",
    "typecheck": "tsc --noEmit",
    "survey-export": "tsx src/survey-export.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
